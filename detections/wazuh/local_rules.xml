<!--
  SOC Detection Lab — Wazuh custom rules (Sysmon)
  Author: Karim EL HAOURATI

  Deploy:
    1) Copy this file to  /var/ossec/etc/rules/local_rules.xml  on the Wazuh manager
       (or append these rules to the existing local_rules.xml).
    2) Ensure Sysmon events are collected (agent <localfile> for
       "Microsoft-Windows-Sysmon/Operational").
    3) Restart:  sudo systemctl restart wazuh-manager
    4) Validate with: /var/ossec/bin/wazuh-logtest

  Rules use Wazuh's built-in Sysmon groups:
    sysmon_event1 (process creation), sysmon_event_10 (process access),
    sysmon_event_13 (registry set), sysmon_event3 (network connection).
  Rule IDs 100100+ are reserved for local custom rules.
-->
<group name="sysmon,attack,soc_detection_lab,">

  <!-- T1059.001 — PowerShell encoded command -->
  <rule id="100100" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\s-enc\s|\s-encodedcommand|\s-ec\s)</field>
    <description>ATT&amp;CK T1059.001: PowerShell encoded command</description>
    <mitre><id>T1059.001</id></mitre>
    <group>execution,</group>
  </rule>

  <!-- T1003.001 — LSASS memory access -->
  <rule id="100101" level="14">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1410|1438|143a|1fffff)$</field>
    <description>ATT&amp;CK T1003.001: LSASS memory access (possible credential dumping)</description>
    <mitre><id>T1003.001</id></mitre>
    <group>credential_access,</group>
  </rule>

  <!-- T1547.001 — Registry Run key persistence -->
  <rule id="100102" level="10">
    <if_group>sysmon_event_13</if_group>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\CurrentVersion\\Run(Once)?\\</field>
    <description>ATT&amp;CK T1547.001: Registry Run key persistence</description>
    <mitre><id>T1547.001</id></mitre>
    <group>persistence,</group>
  </rule>

  <!-- T1053.005 — Scheduled task creation -->
  <rule id="100103" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>ATT&amp;CK T1053.005: Scheduled task creation</description>
    <mitre><id>T1053.005</id></mitre>
    <group>persistence,execution,</group>
  </rule>

  <!-- T1105 — Ingress tool transfer via certutil -->
  <rule id="100104" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\certutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(urlcache|verifyctl)</field>
    <description>ATT&amp;CK T1105: Ingress tool transfer via certutil</description>
    <mitre><id>T1105</id></mitre>
    <group>command_and_control,</group>
  </rule>

  <!-- T1070.001 — Windows event log cleared -->
  <rule id="100105" level="12">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(wevtutil\s+cl|Clear-EventLog)</field>
    <description>ATT&amp;CK T1070.001: Windows event log cleared</description>
    <mitre><id>T1070.001</id></mitre>
    <group>defense_evasion,</group>
  </rule>

  <!-- T1136.001 — Local account creation -->
  <rule id="100106" level="10">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\net1?\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\buser\b.*/add</field>
    <description>ATT&amp;CK T1136.001: Local account creation</description>
    <mitre><id>T1136.001</id></mitre>
    <group>persistence,</group>
  </rule>

</group>
